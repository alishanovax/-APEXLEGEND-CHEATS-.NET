---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from './icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { Prose } from '@/components/starwind/prose';
import { ROUTES } from '../utils/path';

interface Props {
  title: string;
  description: string;
  breadcrumbLabel: string;
  sections: { heading: string; paragraphs: string[] }[];
  /** Optional H2 for route keyword (SEO). */
  keywordSubheading?: string;
  /** When set, section titles render as h3 under the keyword h2 (privacy outline). */
  sectionHeadingLevel?: 'h2' | 'h3';
  /** Optional unique CTA anchor text (SEO / internal links). */
  supportCtaLabel?: string;
  homeCtaLabel?: string;
}

const {
  title,
  description,
  breadcrumbLabel,
  sections,
  keywordSubheading,
  sectionHeadingLevel = 'h2',
  supportCtaLabel = 'Contact support',
  homeCtaLabel = 'Back to home',
} = Astro.props;
---

<article class="py-8 md:py-12">
  <div class="mx-auto max-w-3xl px-5">
    <header class="mt-4 space-y-4 text-center">
      <h1 class="text-3xl font-bold normal-case md:text-4xl">{title}</h1>
      {keywordSubheading ? <h2 class="text-xl font-semibold text-foreground">{keywordSubheading}</h2> : null}
      <p class="text-lg leading-relaxed text-muted-foreground">{description}</p>
    </header>

    <div class="mt-6 text-left">
      <Breadcrumbs
        items={[
          { name: 'Home', path: '/' },
          { name: breadcrumbLabel, path: Astro.url.pathname },
        ]}
      />
    </div>

    <Prose class="mt-10 max-w-none text-left">
      {sections.map((section) => (
        <section class="mt-8">
          {sectionHeadingLevel === 'h3' ? <h3>{section.heading}</h3> : <h2>{section.heading}</h2>}
          {section.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </section>
      ))}
    </Prose>

    <div class="mt-12 flex flex-wrap justify-center gap-3 border-t border-border pt-8">
      <Button as="a" href={ROUTES.support} variant="primary" size="sm">
        {supportCtaLabel}
        <Icon name="mail" size={16} />
      </Button>
      <Button as="a" href={ROUTES.home} variant="outline" size="sm">{homeCtaLabel}</Button>
    </div>
  </div>
</article>
