---
import Icon from './icons/Icon.astro';
import { ROUTES } from '../utils/path';
import { blogTagIcons } from '../data/sectionIcons';
import type { BlogPostFull } from '../data/blog/types';
import { getPostReadTime } from '../data/blog';
import type { IconName } from './icons/types';
import { Badge } from '@/components/starwind/badge';

interface Props {
  post: BlogPostFull;
  class?: string;
}

const { post, class: className } = Astro.props;
const readTimeLabel = getPostReadTime(post);
const tagIcon: IconName = blogTagIcons[post.tag] ?? 'tag';
---

<div class:list={['blog-article__toolbar', className]}>
  <a href={ROUTES.blog} class="blog-article__toolbar-back shrink-0">
    <Icon name="chevronLeft" size={15} aria-hidden="true" />
    All articles
  </a>
  <div class="blog-article__toolbar-meta">
    <Badge variant="secondary" size="sm" class="blog-article__toolbar-badge max-w-[9rem] gap-1 rounded-full" title={post.tag}>
      <Icon name={tagIcon} size={12} class="shrink-0" />
      <span class="truncate">{post.tag}</span>
    </Badge>
    <Badge
      variant="outline"
      size="sm"
      class="blog-article__toolbar-badge shrink-0 gap-1 rounded-full text-foreground"
      title={readTimeLabel}
    >
      <Icon name="clock" size={12} class="shrink-0" aria-hidden="true" />
      <span>{readTimeLabel}</span>
    </Badge>
    <Badge
      variant="outline"
      size="sm"
      class="blog-article__toolbar-badge shrink-0 gap-1 rounded-full text-foreground"
      title={post.date}
    >
      <Icon name="calendar" size={12} class="shrink-0" aria-hidden="true" />
      <span>{post.date}</span>
    </Badge>
  </div>
</div>
